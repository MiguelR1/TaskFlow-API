generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  schemas  = ["login_prueba", "public"]
}

model Usuario {
  id              Int        @id @default(autoincrement())
  email           String     @unique
  nombre          String?
  cedula          String     @unique
  password        String?
  rol             Roles      @default(User)
  projects        Proyecto[]
  tareasAsignadas Tarea[]    @relation("tareaAsignada")
  tareasCreadas   Tarea[]    @relation("tareaCreador")

  comentarios Comentario[]

  @@schema("login_prueba")
}

model Proyecto {
  id          String   @id @default(uuid())
  nombre      String
  descripcion String?
  duenoId     Int
  fechaCreado DateTime @default(now())
  categoria   String?
  color       String?  @default("blue")
  icono       String?  @default("folder")
  dueno       Usuario  @relation(fields: [duenoId], references: [id], onDelete: Cascade)
  tareas      Tarea[]

  @@schema("login_prueba")
}

model Tarea {
  id             String    @id @default(uuid())
  titulo         String
  descripcion    String?
  estado         Estado    @default(Pendiente)
  proyectoId     String
  creadorId      Int
  asignadorId    Int?
  fechaTerminada DateTime?
  fechaCreada    DateTime  @default(now())
  horasEstimadas Decimal   @db.Decimal
  clase          String?
  color          String?
  asignado       Usuario?  @relation("tareaAsignada", fields: [asignadorId], references: [id])
  creador        Usuario   @relation("tareaCreador", fields: [creadorId], references: [id], onDelete: Cascade)
  proyecto       Proyecto  @relation(fields: [proyectoId], references: [id], onDelete: Cascade)
  comentarios Comentario[]

  @@schema("login_prueba")
}

enum Estado {
  Pendiente
  enProgreso
  Terminado

  @@schema("login_prueba")
}

enum Roles {
  User
  Admin

  @@schema("login_prueba")
}

model Comentario {
  id        String   @id @default(uuid())
  contenido String
  fecha     DateTime @default(now())

  tareaId String
  tarea   Tarea  @relation(fields: [tareaId], references: [id], onDelete: Cascade)

  autorId Int
  autor   Usuario @relation(fields: [autorId], references: [id], onDelete: Cascade)

  @@schema("login_prueba")
}
